{
  "name": "@itzik-crm/server",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed:dev": "ts-node --transpile-only prisma/seedDevUsers.ts",
    "db:studio": "prisma studio",
    "bootstrap:superadmin": "ts-node --transpile-only prisma/bootstrapSuperAdmin.ts",
    "test": "node --require ts-node/register --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.6",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.0",
    "prisma": "^7.4.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
