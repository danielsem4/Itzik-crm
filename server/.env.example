# Local development connection string. In production this holds a real
# credential and MUST come from a secret manager / env injection — never commit
# a production DATABASE_URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/itzik_crm?schema=public
PORT=3001

# Optional request body size limit for JSON/urlencoded parsers (default 100kb).
# BODY_LIMIT=100kb

# SMTP (invitation / password-reset emails). Leave the password blank here —
# supply it via a secret manager. In non-production, emails are console.log'ged.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=

# Trusted browser origin — becomes the CORS allow-list. In production this must
# be an explicit https:// origin (no localhost, no wildcard).
CLIENT_URL=http://localhost:5173

# One-off SUPER_ADMIN bootstrap (`npm run bootstrap:superadmin`). Supply these
# out-of-band; never commit real values.
# BOOTSTRAP_SUPERADMIN_EMAIL=
# BOOTSTRAP_SUPERADMIN_PASSWORD=
# BOOTSTRAP_SUPERADMIN_NAME=
